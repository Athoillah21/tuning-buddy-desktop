# ============================================
# Environment for Tuning Buddy (docker compose)
# Copy this file to .env and fill in the two keys
# ============================================

# Django secret key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Fernet key used to encrypt database credentials and AI provider API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable: changing it makes saved passwords and API keys unreadable
ENCRYPTION_KEY=

DEBUG=False

# App database (the postgres container)
POSTGRES_USER=tuning
POSTGRES_PASSWORD=tuning

# Seconds allowed for EXPLAIN ANALYZE on the database being tuned
QUERY_EXECUTION_TIMEOUT=300

# AI provider timeouts in seconds
AI_HEALTH_CHECK_TIMEOUT=30
AI_REQUEST_TIMEOUT=300

# Token budget for one recommendation reply; too low truncates the JSON mid-string
AI_MAX_TOKENS=8192

# Every timing is measured this many times and reduced to its median
MEASUREMENT_REPEATS=3

# Queries faster than this (ms) are reported as already optimal rather than being
# given a percentage that is really cache noise
NOISE_FLOOR_MS=5

# Hours before a saved database password must be re-entered; 0 disables expiry
PASSWORD_EXPIRY_HOURS=1

# AI API keys are NOT configured here any more.
# Open http://localhost:8000/settings/ai/ and add providers in the app.
